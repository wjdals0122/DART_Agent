# 이 파일을 `.env` 로 복사한 뒤 값을 채운다. `.env` 는 git 에 올라가지 않는다.
# 각 변수의 뜻과 기본값은 README.md 의 '환경변수' 절에 있다.

# (필수) HyperCLOVA X API 키. 값은 이 저장소 어디에도 두지 않는다.
CLOVA_API_KEY=

# 아래는 선택 — 비워 두면 기본값을 쓴다.
CLOVA_MODEL=HCX-005
CLOVA_API_HOST=https://clovastudio.stream.ntruss.com

# 서버로 띄울 때만
# PORT=80
# FORCE_CPU=1
# HF_HUB_OFFLINE=1
